# Server Environment Variables for Render / Local Development

# Port (Render sets this dynamically)
PORT=5000

# MongoDB Connection String (MongoDB Atlas cluster URI)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=database

# Frontend Client URL allowed for CORS requests
# Example: 
CLIENT_URL=https://sampatakumar.github.io

# Node Environment
NODE_ENV=production
